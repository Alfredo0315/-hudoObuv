# Следующая команда работает для загрузки при использовании Git для Windows.:
# curl -LOf http://gist.githubusercontent.com/kmorcinek/2710267/raw/.gitignore
#
# Загрузите этот файл с помощью PowerShell v3 под Windows со следующей командой:
# Вызов-WebRequest https://gist.githubusercontent.com/kmorcinek/2710267/raw / -OutFile .gitignore
#
# или wget:
# wget --сертификат без проверки http://gist.githubusercontent.com/kmorcinek/2710267/raw/.gitignore

# Пользовательские файлы
*.suo
*.пользователь
*.sln.docstates

# Результаты сборки
[Dd]ebug/
[Rr]elease/
x64/
[Bb]в/
[Oo]bj/
# папка сборки в настоящее время используется для сценариев сборки, и ее не следует игнорировать
#сборка/

# Пакеты NuGet
*.nupkg
# Папка packages может быть проигнорирована из-за восстановления пакета
**/пакеты/*
# за исключением build /, который используется в качестве целевого объекта MSBuild.
**!/пакеты/сборка/
# Раскомментируйте при необходимости, однако, как правило, он будет восстановлен при необходимости
#!**/packages/repositories.config

