<Window x:Class="ChudoObuv.AddOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый заказ — Чудо Обувь" Height="620" Width="980"
        MinWidth="800" MinHeight="500"
        FontFamily="Calibri" FontSize="14" Background="#FFFFFF"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Клиент:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="ClientBox" Width="280" DisplayMemberPath="Fio"/>
            <TextBlock Text="Дата заказа:" VerticalAlignment="Center" Margin="24,0,8,0"/>
            <DatePicker x:Name="DateBox" Width="150"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- каталог с поиском по наименованию -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Каталог"
                           FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                         TextChanged="SearchBox_TextChanged" ToolTip="Поиск по наименованию"/>
                <ListBox x:Name="ProductsList"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ProductItem_Click"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6" Margin="0,0,0,4" CornerRadius="4"
                                    BorderBrush="#70B2AF" BorderThickness="1" Background="#D2F6E7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Image}" Width="48" Height="48" Stretch="Uniform"/>
                                    <StackPanel Grid.Column="1" Margin="8,0">
                                        <TextBlock FontWeight="Bold">
                                            <Run Text="{Binding Manufacturer, Mode=OneWay}"/>
                                            <Run Text=" | "/>
                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Category}" Foreground="#555"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="Bold"
                                               Foreground="#70B2AF"
                                               Text="{Binding PriceWithDiscount, StringFormat='{}{0:0.00} ₽'}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- позиции нового заказа -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Позиции заказа" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock x:Name="TotalText" DockPanel.Dock="Bottom" FontWeight="Bold" FontSize="16"
                           HorizontalAlignment="Right" Margin="0,8,0,0"/>
                <DataGrid x:Name="ItemsGrid" IsReadOnly="True" AutoGenerateColumns="False"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="70"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="65"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding Sum, StringFormat='{}{0:0.00}'}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Назад" Click="Back_Click" Padding="16,4" Margin="0,0,8,0"/>
            <Button Content="Удалить позицию" Click="RemoveItem_Click" Padding="16,4" Margin="0,0,8,0"/>
            <Button Content="Сохранить заказ" Click="Save_Click"
                    Background="#70B2AF" Foreground="White" Padding="16,4"/>
        </StackPanel>
    </Grid>
</Window>