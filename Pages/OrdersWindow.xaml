<Window x:Class="ChudoObuv.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список заказов — Чудо Обувь" Height="500" Width="760"
        FontFamily="Calibri" FontSize="14" Background="#FFFFFF"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="OrdersGrid" IsReadOnly="True" AutoGenerateColumns="False"
                  SelectionMode="Single" MouseDoubleClick="OrdersGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding OrderId}" Width="70"/>
                <DataGridTextColumn Header="Дата заказа" Binding="{Binding Date}" Width="130"/>
                <DataGridTextColumn Header="ФИО клиента" Binding="{Binding Client}" Width="*"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat='{}{0:0.00} ₽'}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Назад" Click="Back_Click" Padding="16,4" Margin="0,0,8,0"/>
            <Button Content="Состав заказа" Click="Open_Click" Padding="16,4" Margin="0,0,8,0"/>
            <Button Content="Удалить заказ" Click="Delete_Click" Padding="16,4" Margin="0,0,8,0"/>
            <Button Content="Добавить заказ" Click="Add_Click"
                    Background="#70B2AF" Foreground="White" Padding="16,4"/>
        </StackPanel>
    </Grid>
</Window>