<Window x:Class="ChudoObuv.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Состав заказа — Чудо Обувь" Height="520" Width="720"
        FontFamily="Calibri" FontSize="14" Background="#FFFFFF"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,10">
            <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="ClientText" Margin="0,2,0,8"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Дата заказа:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="DateBox" Width="150"/>
                <Button x:Name="SaveDateButton" Content="Сохранить дату" Click="SaveDate_Click"
                        Padding="12,2" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="ItemsGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding Product}" Width="*"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="80"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="70"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding UnitPrice, StringFormat='{}{0:0.00}'}" Width="90"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Sum, StringFormat='{}{0:0.00}'}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="TotalText" Grid.Row="2" FontWeight="Bold" FontSize="16"
                   HorizontalAlignment="Right" Margin="0,10"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Назад" Click="Back_Click" Padding="16,4" Margin="0,0,8,0"/>
            <Button x:Name="RemoveItemButton" Content="Удалить позицию" Click="RemoveItem_Click"
                    Padding="16,4"/>
        </StackPanel>
    </Grid>
</Window>