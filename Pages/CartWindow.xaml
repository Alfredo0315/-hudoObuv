<Window x:Class="ChudoObuv.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ — Чудо Обувь" Height="480" Width="640"
        FontFamily="Calibri" FontSize="14" Background="#FFFFFF"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="CartGrid" IsReadOnly="True" AutoGenerateColumns="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="80"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="70"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding UnitPrice, StringFormat='{}{0:0.00}'}" Width="90"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Sum, StringFormat='{}{0:0.00}'}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="TotalText" Grid.Row="1" FontWeight="Bold" FontSize="16"
                   HorizontalAlignment="Right" Margin="0,10"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Назад" Click="Back_Click" Padding="16,4" Margin="0,0,8,0"/>
            <Button Content="Удалить позицию" Click="Remove_Click" Padding="16,4" Margin="0,0,8,0"/>
            <Button Content="Подтвердить заказ" Click="Confirm_Click"
                    Background="#70B2AF" Foreground="White" Padding="16,4"/>
        </StackPanel>
    </Grid>
</Window>