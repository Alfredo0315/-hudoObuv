<Window x:Class="ChudoObuv.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар — Чудо Обувь" Height="560" Width="640"
        FontFamily="Calibri" FontSize="14" Background="#FFFFFF"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image x:Name="ProductImage" Width="200" Height="200" Stretch="Uniform"/>

        <StackPanel Grid.Column="1" Margin="16,0,0,0">
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="CategoryText"/>
            <TextBlock x:Name="ManufacturerText"/>
            <TextBlock x:Name="PriceText" Foreground="#70B2AF" FontWeight="Bold" FontSize="16"/>
            <TextBlock x:Name="CompositionText" TextWrapping="Wrap"/>
            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap"/>
            <TextBlock x:Name="SizeRangeText"/>

            <TextBlock Text="Размер:" Margin="0,16,0,4"/>
            <ComboBox x:Name="SizeBox" DisplayMemberPath="Size"/>
            <TextBlock Text="Количество пар:" Margin="0,8,0,4"/>
            <TextBox x:Name="QuantityBox" PreviewTextInput="QuantityBox_PreviewTextInput"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Назад" Click="Back_Click" Padding="16,4" Margin="0,0,8,0"/>
            <Button Content="Добавить в заказ" Click="AddToCart_Click"
                    Background="#70B2AF" Foreground="White" Padding="16,4"/>
        </StackPanel>
    </Grid>
</Window>