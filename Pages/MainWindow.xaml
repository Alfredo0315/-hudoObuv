<Window x:Class="ChudoObuv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Каталог обуви — Чудо Обувь" Height="600" Width="900"
        MinWidth="700" MinHeight="450"
        FontFamily="Calibri" Background="#FFFFFF">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- поиск/фильтр/сортировка/ФИО/корзина/выход -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="UserFioText" DockPanel.Dock="Right"
                       VerticalAlignment="Center" FontWeight="Bold" Margin="8,0,0,0"/>
            <Button Content="Выйти" DockPanel.Dock="Right" Click="Logout_Click"
                    Padding="12,2" Margin="8,0,0,0"/>
            <Button x:Name="CartButton" Content="Корзина" DockPanel.Dock="Right" Click="Cart_Click"
                    Background="#70B2AF" Foreground="White" Padding="12,2" Margin="8,0,0,0"/>
            <Button x:Name="OrdersButton" Content="Заказы" DockPanel.Dock="Right" Click="Orders_Click"
                    Visibility="Collapsed" Padding="12,2" Margin="8,0,0,0"/>
            <ComboBox x:Name="SortBox" DockPanel.Dock="Right" Width="160" Margin="8,0,16,0"
                      VerticalAlignment="Center" SelectionChanged="Filters_Changed">
                <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                <ComboBoxItem Content="Цена по возрастанию"/>
                <ComboBoxItem Content="Цена по убыванию"/>
            </ComboBox>
            <ComboBox x:Name="CategoryFilter" DockPanel.Dock="Right" Width="180" Margin="8,0"
                      VerticalAlignment="Center" SelectionChanged="Filters_Changed"/>
            <TextBox x:Name="SearchBox" VerticalAlignment="Center"
                     TextChanged="Filters_Changed" ToolTip="Поиск по наименованию и описанию"/>
        </DockPanel>

        <ListBox x:Name="ProductsList" Grid.Row="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 BorderThickness="0" Background="#FFFFFF">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ProductItem_Click"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,0,0,8" CornerRadius="6"
                            BorderBrush="#70B2AF" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#D2F6E7"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LowStock}" Value="True">
                                        <Setter Property="Background" Value="#ff8080"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding Image}"
                                   Width="80" Height="80" Stretch="Uniform"/>

                            <StackPanel Grid.Column="1" Margin="12,0">
                                <TextBlock FontSize="15" FontWeight="Bold">
                                    <Run Text="{Binding Manufacturer, Mode=OneWay}"/>
                                    <Run Text=" | "/>
                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Category}" Foreground="#555"/>
                                <TextBlock Text="{Binding StockText, StringFormat='Количество: {0}'}"/>
                                <TextBlock Text="{Binding Composition}" Foreground="#555"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock FontSize="16" FontWeight="Bold" Foreground="#70B2AF">
                                    <Run Text="{Binding PriceWithDiscount, StringFormat='{}{0:0.00}', Mode=OneWay}"/>
                                    <Run Text=" ₽"/>
                                </TextBlock>
                                <!-- при скидке ещё отображается старая цена -->
                                <TextBlock Text="{Binding Price, StringFormat='{}{0:0.00} ₽'}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>